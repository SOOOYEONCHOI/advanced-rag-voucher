# 지능형 작업표준 안내 AI(RAG) backend 런타임 이미지 — Python 과 의존성만 넣고 소스는 넣지 않는다.
# 소스는 WAS 의 /opt/yest/chatbot/backend 를 /app 에 읽기 전용으로 붙인다(docker-compose.prod.yml).
# requirements.txt 나 이 파일이 바뀔 때만 다시 만든다 — 태그는 두 파일의 해시다(build_package.sh).
# 빌드(저장소 루트에서): docker build -f deploy/webwas/chatbot/Dockerfile.runtime -t chatbot-backend-runtime:<해시> adrag_backend
# 설명: docs/design/운영배포_가이드_서버별_v1.1.md §4.1 · docs/design/운영배포_수정배포_가이드_v1.1.md §4.1
#
# TODO(결정필요: P-2 기본 이미지 패치 버전 — MAIP 와 맞추려면 python:3.12.15-slim 처럼 정확한 태그로 고정한다)
# 2026.11.13(sooyeon.choi) 수정 - LibreOffice(시트 미리보기·.xls)와 LibreDWG(도면 등록)를 넣었다
ARG PYTHON_IMAGE=python:3.12-slim

# ── 1단계: 의존성 빌드 ─────────────────────────────────────
FROM ${PYTHON_IMAGE} AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

RUN pip install --upgrade pip setuptools wheel
# CPU 판 torch — adrag_backend/Dockerfile 과 같은 버전
RUN pip install torch==2.4.0 torchvision==0.19.0 --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt && pip check

# 2026.11.13(sooyeon.choi) 도면 파싱 기능 추가 - DWG→DXF 변환기 LibreDWG(GPLv3)를 소스로 빌드해 dwg2dxf 만 쓴다(별도 프로세스 호출, 링크 없음)
#   운영 도면 등록(DRAWING_PARSE_MODE=backend)에 필요. 빌드 PC 에서만 인터넷(ftp.gnu.org)을 쓴다
ARG LIBREDWG_VERSION=0.13.3
RUN apt-get update && apt-get install -y --no-install-recommends make xz-utils curl \
    && curl -fsSL "https://ftp.gnu.org/gnu/libredwg/libredwg-${LIBREDWG_VERSION}.tar.xz" -o /tmp/libredwg.tar.xz \
    && tar -xJf /tmp/libredwg.tar.xz -C /tmp \
    && cd /tmp/libredwg-${LIBREDWG_VERSION} \
    && ./configure --disable-bindings --disable-docs --prefix=/opt/libredwg \
    && make -j"$(nproc)" && make install \
    && cd / && rm -rf /tmp/libredwg* /var/lib/apt/lists/*

# ── 2단계: 실행 ────────────────────────────────────────────
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:$PATH

# poppler-utils: PDF 처리, curl: 헬스체크
# 2026.11.13(sooyeon.choi) 수정 - adrag_backend/Dockerfile 과 맞춤: 원본 Excel 시트 PDF 미리보기·.xls 변환용 LibreOffice UNO 와 한글 글꼴
#   (SHEET_PREVIEW_PYTHON=/usr/bin/python3 은 python3-uno 가 설치하는 데비안 python). 한글 글꼴은 도면 이미지(fonts.yaml)에도 쓴다
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils libreoffice-calc python3-uno fonts-noto-cjk fonts-nanum curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
# 2026.11.13(sooyeon.choi) 도면 파싱 기능 추가 - LibreDWG. 변환기는 PATH·LANG 만 넘겨 실행하므로(LD_LIBRARY_PATH 없음)
#   라이브러리는 ldconfig 에 등록하고, LIBREDWG_BIN 기본값 dwg2dxf 로 찾도록 /usr/local/bin 에 링크한다
COPY --from=builder /opt/libredwg /opt/libredwg
RUN echo /opt/libredwg/lib > /etc/ld.so.conf.d/libredwg.conf && ldconfig \
    && ln -s /opt/libredwg/bin/dwg2dxf /usr/local/bin/dwg2dxf \
    && env -i PATH=/usr/local/bin:/usr/bin:/bin dwg2dxf --version

WORKDIR /app
EXPOSE 8081

# compose 의 user: 로 chatbot 계정 UID/GID 를 준다. 그것을 빠뜨려도 root 로 돌지 않게 nobody 로 둔다
USER 65534:65534

# 적재 큐가 앱 프로세스 안에 있어(Phase 3 전) 워커는 1 로 고정한다
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8081", "--workers", "1"]
