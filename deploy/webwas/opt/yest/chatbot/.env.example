# 지능형 작업표준 안내 AI(RAG) 운영 .env 견본 — 이름과 비밀이 아닌 고정값만 적는다. 비밀·주소는 서버에서 입력한다.
# /opt/yest/chatbot/.env 로 복사한다(sychoi:chatbot 640). 바꾼 뒤 sudo systemctl restart chatbot
# 경로는 컨테이너 안 경로다(docker-compose.prod.yml volumes). 설명: docs/design/운영배포_가이드_서버별_v1.1.md §4.3 ⑦

# ── DB (Cloud DB for PostgreSQL) ──────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=15020
POSTGRES_DB=yest_chat
POSTGRES_USER=rag_chatbot
POSTGRES_PASSWORD=

# ── 저장 경로 (/data = /mnt/a/chatbot/data) ───────────────
UPLOADED_FILES_BASE_DIR=/data/data
MD_SAVE_DIR=/data/parsed_md
RESOURCE_STORAGE_ROOT=/data/xl_res
LOG_PATH=/logs
HF_CACHE_DIR=/cache/hf

# ── Qdrant (Vector DB 서버) ───────────────────────────────
QDRANT_HOST=
QDRANT_PORT=6333

# ── 모델 서버 (GPU 서버, R-9) ─────────────────────────────
VLLM_API_URL=
VLLM_API_KEY=
VLLM_MODEL_NAME=
VLLM_MAX_MODEL_LEN=
VLLM_MAX_TOKENS=
VLLM_TEMPERATURE=
VLLM_TP_SIZE=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIM=
EMBEDDING_MAX_MODEL_LEN=
ENABLE_RERANKING=
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
VOICE_ASR_API_URL=
VOICE_ASR_API_KEY=
VOICE_ASR_MODEL_NAME=

# ── 파서 (docling-parser) ─────────────────────────────────
DOCLING_PARSER_HOST=
DOCLING_API_KEY=
RESOURCE_INTERNAL_API_KEY=
RESOURCE_DELIVERY=pull

# ── 검색·적재 ─────────────────────────────────────────────
# 폐쇄망: bm42 는 fastembed 가 모델을 내려받는다 → none (N-3)
SPARSE_ENCODER_TYPE=none
MAX_CHUNK_SIZE=
CHUNK_OVERLAP=
TOP_K_RESULTS=
ENABLE_SEMANTIC_ENRICHMENT=
ENABLE_METADATA_FILTERING=
ENABLE_QUERY_PREPROCESSING=
# 2026.11.13(sooyeon.choi) 추가 - 코드 기본값이 v2 다. 운영 BM25 를 v1 로 계산해 두었으면 v1 로 고정(바꾸면 rebuild_kiwi_bm25.py --apply)
KIWI_BM25_ENCODER_VERSION=kiwi-bm25-v1
# 2026.11.13(sooyeon.choi) 추가 - 시트 미리보기 작업 폴더(/app 은 읽기 전용). 도면 등록 켬(한도는 nginx 60m 에 맞춤)
SHEET_PREVIEW_WORK_ROOT=/data/sheet_preview
DRAWING_PARSE_MODE=backend
DRAWING_MAX_UPLOAD_MB=60

# ── 보안 ──────────────────────────────────────────────────
# 운영 전용 새 값. 개발 값을 옮기지 않는다
JWT_SECRET_KEY=
JWT_ALGORITHM=
CORS_ORIGINS=

# ── 로그 ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=
LOG_ERROR_RETENTION_DAYS=

# ── 넣지 않는다 ───────────────────────────────────────────
# DEV_BOOTSTRAP_ADMIN, DEV_BOOTSTRAP_ADMIN_ID, ADMIN_PASSWORD (D-19, 관리자는 create_admin.py 로)
# OPENAI_API_KEY (외부 AI API 금지), POSTGRES_TEST_DB
