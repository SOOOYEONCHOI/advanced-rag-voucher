# ManufacturingAIPlatform 환경변수 예시
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 커밋하지 않는다.

# 비우면 False(운영). 개발 PC 만 True.
DEBUG=True
SECRET_KEY=change-me-generate-with-django-get-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8123,http://127.0.0.1:8123
HTTPS_ENABLED=False

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yest
DB_USER=yest
DB_PASSWORD=change-me
DB_SEARCH_PATH=public
# 운영(gunicorn)은 60. 개발(runserver)은 0 으로 둔다 — 요청마다 스레드가
# 바뀌어 0 보다 크면 커넥션이 idle 로 샌다. AGENTS.md [4] 참조.
DB_CONN_MAX_AGE=60
DB_APPLICATION_NAME=manufacturing_ai_platform

# 업로드 원본·파생 파일. 비우면 저장소의 storage/. 운영은 /mnt/a/maip/data
STORAGE_ROOT=
# `/api/v1` 로 내려주는 배포물(LGPL 대응 소스·Client zip) 위치.
# 비우면 저장소의 distribution/ 을 쓴다. 운영은 /mnt/a/maip/distribution
DISTRIBUTION_ROOT=
# 시스템 로그 폴더. 비우면 STORAGE_ROOT/logs. 날마다 app-YYYY-MM-DD.log 로 나뉜다.
# 서비스 계정이 쓸 수 있어야 한다. 보존 기간(일)이 지난 파일은 지운다(0 이면 지우지 않음). 운영은 /mnt/a/maip/logs
LOG_DIR=
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

# API 인가 훅 모드 (Phase 1): off | warn | enforce
API_AUTHZ_MODE=enforce
TENANT_RLS_ENABLED=True

# 워커가 강제 종료돼 RUNNING 으로 남은 작업을 다시 집기까지 기다리는 시간(초).
# 가장 오래 걸리는 Export 보다 길게 둔다. 짧으면 정상 작업이 두 번 돈다.
WORKER_STALE_SECONDS=3600

# 큰 파일 전송을 nginx 에 넘긴다(X-Accel-Redirect). 운영 True, 개발(runserver, nginx 없음) False.
# 켜려면 nginx 에 /_protected/media/ · /_protected/distribution/ internal location 이 있어야 한다(DEPLOYMENT §4).
FILE_ACCEL_REDIRECT=False

# PostgreSQL 통합 테스트 DB(configurations/pg_test_settings.py). DBA 가 만든 maip_test 만 허용한다.
PG_TEST_DB_NAME=maip_test

# Wezard(학습·추론 서버) — 우리가 모델 목록·조회·추론을 부를 때 쓴다(docs/Wezard/integration-protocol.md).
# 키는 Wezard 관리자가 발급해 따로 전달한다. 개발은 같은 장비의 8000 포트, 운영은 별도 서버 주소.
# 아래는 개발 Wezard 값이다 — 운영은 비우고 시작해 운영 Wezard 주소·키를 받으면 채운다(비면 추론 없이 이미지만 저장).
WEZARD_BASE_URL=http://10.10.10.20:8000
WEZARD_API_KEY=wz_change-me

# 상단 바 We.RAG 로고가 새 탭으로 여는 주소. 비우면 로고를 보이지 않는다(http·https 만).
# 아래는 개발 값이다 — 운영은 https://chatbot.yest.co.kr
WERAG_URL=http://10.10.10.109/
