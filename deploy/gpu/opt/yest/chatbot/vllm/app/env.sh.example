# 운영 GPU 서버 vLLM 공통 환경 변수 — /opt/yest/chatbot/vllm/app/env.sh (vllm-admin, 600)
# 기준: vllm/app/env.sh, run_adrag_model_v2.sh, run_qwen3_ASR.sh (개발 서버)
# 키 값은 WAS backend .env 의 같은 이름 값과 같아야 한다. 2026-10-28 사용자 요청으로 실제 값을 넣었다 — SVN 에 올리지 않는다.
export VLLM_API_KEY=""
export EMBEDDING_API_KEY=""
export RERANKER_API_KEY=""
export VOICE_ASR_API_KEY=""
# 2026.11.05 추가 - VLM 테스트(Gemma4-12B-it, run-vlm.sh). backend 쪽 이름도 VLM_API_KEY
export VLM_API_KEY=""

# 폐쇄망: Hugging Face 접속 시도 차단, 사용 통계 전송 끔
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1

# 개발 서버와 같은 값 — nvcc 없이 동작
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
export VLLM_DISABLE_FLASHINFER=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# 오디오 제한 (ASR)
export VLLM_AUDIO_FETCH_TIMEOUT=60
export VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=50
