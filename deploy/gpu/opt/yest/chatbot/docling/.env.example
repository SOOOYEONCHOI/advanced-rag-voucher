# 운영 docling-parser 환경 변수 (서버: /opt/yest/chatbot/docling/.env, root:adrag 640)
# 이 파일을 .env로 복사한 뒤 서버에서 직접 값을 넣는다. 비밀 값은 PC·문서에 남기지 않는다.
# 빈 값으로 두면 기동이 실패하는 항목(LOG_LEVEL, LOG_RETENTION_DAYS 등)은 값을 채우거나 줄을 지운다.

# 인증 (python generate_api_key.py 로 새로 만든 값. 개발 값 재사용 금지)
API_KEY=

# 파서 동작 (개발 서버와 같은 값)
EXCEL_PARSER=openpyxl
RESOURCE_DELIVERY=pull
PARSER_RESOURCE_TTL_HOURS=24
PARSER_RESOURCE_CLEANUP_INTERVAL_SECONDS=3600

# 로그 (운영은 INFO 권장)
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# backend로 사진 파일 보내기(push) 방식일 때만 사용. pull 방식이면 지워도 된다.
# BACKEND_INTERNAL_URL=
# BACKEND_INTERNAL_API_KEY=
# BACKEND_CALLBACK_ALLOWLIST=
