# =============================================================================
# .env — 모든 설정값의 단일 소스 (Single Source of Truth)
#
# 배포 환경별 URL 주의:
#   로컬/직접 실행  : 외부 IP (예: http://49.247.45.119:8002)
#   Docker Compose : 내부 서비스명으로 자동 오버라이드 (docker-compose.yml 참조)
# =============================================================================

# ── Docling 파싱 서버 ───────────────────────────────────────────────────────
# DOCLING_PARSER_HOST=http://49.247.45.119:8008
# DOCLING_API_KEY="h^XynYewJ!McLVs*a8ulQpmPv85D&Z7BUx9naSqnVZlGW!DeZraJu5orX*ui$#eH"
# DOCLING_PARSER_HOST=http://49.247.45.119:8007
# DOCLING_API_KEY="!VaQg#hD#yqO3IdUzdIgPN%qK*WfCjwiBRgDtNkSw2oPmAKx^WyqJwo&nBLR%xD#"
DOCLING_PARSER_HOST=http://10.10.10.109
# 2026.08.28(sooyeon.choi) 수정 - docling-parser의 API_KEY와 동일해야 함
DOCLING_API_KEY="!VaQg#hD#yqO3IdUzdIgPN%qK*WfCjwiBRgDtNkSw2oPmAKx^WyqJwo&nBLR%xD#"
EXCEL_PARSE_MODE=backend
# 엑셀 사진 전부 자동 연결(기본 true, false면 SOP Step 사진만 연결)
EXCEL_IMAGE_LINK_ALL=true
ANSWER_IMAGE_SOURCE=citation   # llm, citation
RAG_MAX_IMAGES=4
# 2026.11.06(sooyeon.choi) 추가 - 문서 버전 관리 관련 설정
DOCUMENT_VERSION_VECTOR_RETENTION_ENABLED=true
DOCUMENT_VERSION_RESTORE_ENABLED=true
DOCUMENT_VERSION_FILTER_MODE=nested    # nested(기본) | doc_version(백필 후 사용)

# ── Ollama LLM 서빙 ───────────────────────────────────────────────────────
OLLAMA_API_URL=http://49.247.45.119:11434
OLLAMA_MODEL_NAME=qwen3:14b

# ── vLLM LLM 서빙 ──────────────────────────────────────────────────────────
# VLLM_API_URL=http://10.10.10.110:8001
VLLM_API_URL=http://10.10.10.110:8011
VLLM_API_KEY=af534ea6-344c-4497-8696-81a76e141b88
# VLLM_API_URL=http://49.247.45.119:8001
# VLLM_API_KEY="7c2d9f41-8a63-4e17-b5c9-2f846d0a731e"
# VLLM_MODEL_NAME=Qwen/Qwen3-8B
# VLLM_MODEL_NAME=Qwen/Qwen3.5-9B
# VLLM_MODEL_NAME=Qwen3-8B
# VLLM_MODEL_NAME=Qwen3.5-9B
VLLM_MODEL_NAME=gemma-4-12B-it
# VLLM_MODEL_NAME=SOLAR-10.7B-Instruct
VLLM_MAX_MODEL_LEN=24576   # 8192
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0
MAX_PROMPT_TOKENS=21504
MAX_CONTEXT_CHARS=32000
VLLM_TP_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.68

# ── vLLM STT/TTS 서빙 ────────────────────────────────────────────────────
# API key falls back to VLLM_API_KEY when VOICE_ASR_API_KEY / VOICE_TTS_API_KEY are unset.
VOICE_ASR_API_URL=http://10.10.10.110:8007
VOICE_ASR_MODEL_NAME=Qwen3-ASR-1.7B
VOICE_ASR_TIMEOUT=90
VOICE_MAX_UPLOAD_BYTES=52428800
VOICE_ASR_E2E_AUDIO_PATH=tests/fixtures/stt
VOICE_ASR_E2E_MAX_CER=0.1

VOICE_TTS_API_URL=http://10.10.10.110:8008
VOICE_TTS_MODEL_NAME=Qwen3-TTS-1.7B
VOICE_TTS_TIMEOUT=120
VOICE_TTS_VOICE=sohee
VOICE_TTS_E2E_TEXT_PATH=tests/fixtures/stt/expected.json
VOICE_TTS_E2E_MAX_CER=0.15

# ── vLLM Embedding 서빙 ────────────────────────────────────────────────────
EMBEDDING_API_URL=http://10.10.10.110:8002
EMBEDDING_API_KEY=af534ea6-344c-4497-8696-81a76e141b88
# EMBEDDING_API_URL=http://49.247.45.119:8002
# EMBEDDING_API_KEY="7c2d9f41-8a63-4e17-b5c9-2f846d0a731e"
# ── [A] Qwen3-Embedding-4B (2560) ─────────────────────
EMBEDDING_MODEL_NAME=Qwen3-Embedding-4B
EMBEDDING_DIM=2560
EMBEDDING_MAX_MODEL_LEN=8192
#   ↳ EMBEDDING_INSTRUCT_TEMPLATE 줄 없음 = Qwen 기본 Instruct 사용
# ── [B] snowflake-arctic-embed-l-v2.0-ko (1024) ───────
# EMBEDDING_MODEL_NAME=snowflake-arctic-embed-l-v2.0-ko
# EMBEDDING_DIM=1024
# EMBEDDING_MAX_MODEL_LEN=8192
# EMBEDDING_INSTRUCT_TEMPLATE=query: {query}
# ── [C] PIXIE-Rune-v1.5 (1024) ────────────────────────
# EMBEDDING_MODEL_NAME=PIXIE-Rune-v1.5
# EMBEDDING_DIM=1024
# EMBEDDING_MAX_MODEL_LEN=6144
# EMBEDDING_INSTRUCT_TEMPLATE=query: {query}

# EMBEDDING_API_URL=http://49.247.45.119:8001
# EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
EMBEDDING_TIMEOUT=300
EMBEDDING_BATCH_SIZE=4

# ── Reranker (vLLM score API) ───────────────────────────────────────────────
# 2026.04.21(sooyeon.choi) reranker api 호출 분기 처리 추가 - 방화벽 해결 후 true로 변경
# ENABLE_RERANKING=false
ENABLE_RERANKING=true
RERANKER_API_URL=http://10.10.10.110:8003
RERANKER_API_KEY=af534ea6-344c-4497-8696-81a76e141b88
# RERANKER_API_URL=http://49.247.45.119:8003
# RERANKER_API_KEY="7c2d9f41-8a63-4e17-b5c9-2f846d0a731e"
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# 2026.11.19(sooyeon.choi) 수정 - dev 리랭커 서버가 Qwen3-Reranker-0.6B로 바뀌어 옛 모델명(bge-reranker-v2-m3) 요청이 404 → 전 질의 폴백(검색 상위 3개 통과)
# RERANKER_MODEL_NAME=bge-reranker-v2-m3
RERANKER_MODEL_NAME=Qwen3-Reranker-0.6B
RERANKER_PROMPT_FORMAT=qwen3

# ── VLM (vLLM /v1/chat/completions) ───────────────────────────────────────────────
VLM_API_URL=http://10.10.10.110:8005
VLM_API_KEY=af534ea6-344c-4497-8696-81a76e141b88
VLM_MODEL_NAME=Qwen3-VL-8B-Instruct

# ── HuggingFace ─────────────────────────────────────────────────────────────
HF_TOKEN=
HF_CACHE_DIR=/mnt/huggingface-cache

# ── RAG 평가 모델 설정 ───────────────────────────────────────────────────────
# ANSWER_CORRECTNESS_JUDGE_BACKEND=openai
# ANSWER_CORRECTNESS_JUDGE_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=''

# ── 데이터베이스 ────────────────────────────────────────────────────────────
# Docker Compose 실행 시 SQLITE_DB_PATH는 docker-compose.yml에서 컨테이너 경로로 오버라이드됨
QDRANT_HOST=qdrant
QDRANT_PORT=6333
#   로컬 실행 기준 HOST=localhost. dev 컨테이너는 docker-compose.dev.yml이 postgres-dev로 덮어쓴다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot_dev
POSTGRES_TEST_DB=rag_chatbot_test
POSTGRES_USER=rag_chatbot
POSTGRES_PASSWORD=m2FgNQVcg9HCFBwyd6N2PsAV_9LsYJQi
DEV_BOOTSTRAP_ADMIN=true
DEV_BOOTSTRAP_ADMIN_ID="admin"
ADMIN_PASSWORD="admin@rnd123"

# ── 청킹 ────────────────────────────────────────────────────────────────────
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=160
TOP_K_RESULTS=10
# MAX_QUERY_TOP_K=20               # 기본값: 20  (API 허용 최대 top_k)
# MAX_CITATION_RESULTS=8           # 기본값: 8   (응답에 포함할 최대 인용 수)

# ── 시맨틱 보강 (LLM enrichment) ───────────────────────────────────────────
# true: Ingest 시 LLM이 summary/keywords/entities/topics/intent 자동 추출
ENABLE_SEMANTIC_ENRICHMENT=true

# ── 보안 ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=1440      # 기본값: 1440분 (24시간)

# ── 메타데이터 필터링 ──────────────────────────────────────────────────────
# 질의 기반 메타데이터 필터링 전체 on/off
ENABLE_METADATA_FILTERING=true
# 규칙 기반 질의 전처리(약어 확장, 패턴 매칭, 형태소 분석) on/off
ENABLE_QUERY_PREPROCESSING=true
# ANONYMOUS_DEFAULT_COLLECTIONS=[] # 기본값: []  (빈 배열 = anonymous 검색 차단)

# ── 검색 튜닝 (2026.11.11(sooyeon.choi) 추가 ──
# BM25 토큰 정책: kiwi-bm25-v1(기존) / kiwi-bm25-v2(모델 코드·규격·호기 보존)
#   바꾸면 기존 문서도 다시 계산해야 한다: scripts/rebuild_kiwi_bm25.py --apply → backend 재기동
KIWI_BM25_ENCODER_VERSION=kiwi-bm25-v2
# 질의 "N조/N항/N호" → "제N조" 법령 표기 변환·법령 질의 분류. 법령 문서도 사용하므로 기본 true 유지
# QUERY_LAW_NOTATION_NORMALIZE=true
# 가중치 추천안(결정 대기: 법령 컬렉션 영향 확인 후). 세 줄을 함께 켜야 효과가 있다(k=20 없으면 오히려 하락)
#   QUERY_TYPE_PROFILE: legacy(기본, 기존) / sop(법령 조문 질의 외 Dense 1.0·BM25 1.5)
#   DENSE_ORIGINAL_QUERY_SHARE: Dense 가중치 중 원문 질의 비중(0~1). 비우면 균등(기존)
#   HYBRID_RRF_K: RRF 상수(기본 60). 모든 컬렉션 공통
QUERY_TYPE_PROFILE=legacy
DENSE_ORIGINAL_QUERY_SHARE=0.5
HYBRID_RRF_K=20

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:3001

# ── Sparse Encoder ──────────────────────────────────────────────────────────
# "none"  : 기존 Python BM25 유지
# "bm42"  : fastembed BM42 로컬 실행 (권장)
# "splade": 외부 SPLADE 서버 API 호출
SPARSE_ENCODER_TYPE=none
BM42_MODEL_NAME=Qdrant/bm42-all-minilm-l6-v2-attentions
# SPLADE_API_URL=http://splade-server:8000
# SPLADE_MODEL_NAME=naver/splade-cocondenser-ensembledistil

# ── LLM 요청 타임아웃 ───────────────────────────────────────────────────────
# VLLM_TIMEOUT=120.0               # 기본값: 120.0초 (LLM 응답 타임아웃)

# ── 파싱 결과 마크다운 저장 (2026.05.22 sooyeon.choi 추가) ──────────────────
MD_SAVE_DIR=instance/parsed_md   # 기본값: instance/parsed_md (빈 문자열이면 저장 안 함)

# ── 스프레드시트 resource 저장 (2026.08.27 sooyeon.choi 추가) ────────────────
# 컨테이너 내부 저장 root. DB에는 이 경로 기준 상대 경로만 저장된다.
RESOURCE_STORAGE_ROOT=/app/instance/xl_res
# parser → backend 내부 업로드 API 인증 키. docling-parser의 BACKEND_INTERNAL_API_KEY와 동일해야 한다.
RESOURCE_INTERNAL_API_KEY="b7peK3UJwBsjdJahcTq5HPzsfMTBbsRMXgb9KGbvT8t3DCxTUuMtjGWKXuzueGUa"
# resource 1건 최대 업로드 크기(byte). 기본 50MB
RESOURCE_MAX_UPLOAD_BYTES=52428800
# staging 보관 시간(시간). 초과분은 주기 cleanup이 삭제
RESOURCE_STAGING_TTL_HOURS=24
RESOURCE_CLEANUP_INTERVAL_SECONDS=3600
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=30
LOG_ERROR_RETENTION_DAYS=90
# 2026.08.28(sooyeon.choi) 추가 - resource 전달 방식
#   pull: 파서가 보관하고 백엔드가 가져간다. 백엔드가 사설망/루프백이어도 동작하며
#         내 PC로 들어오는 연결이 없으므로 방화벽/라우팅/포트개방이 필요 없다.
#   push: 파서가 백엔드로 업로드한다. 파서에서 백엔드에 접근 가능해야 한다.
RESOURCE_DELIVERY=pull
# push 모드에서만 사용. 파서가 회신할 이 백엔드의 주소(파서 allowlist에 등록 필요).
BACKEND_CALLBACK_URL=
# 2026.11.12(sooyeon.choi) 도면 파싱 기능 추가 - 도면 업로드·파싱 켬(검색 미적용)
DRAWING_PARSE_MODE=backend

# 2026.11.18(sooyeon.choi) 추가 - 시험 대응 일괄 질의(dev만 켬)
EVAL_BATCH_QUERY_ENABLED=true

# 2026.11.18(sooyeon.choi) 추가 - 데이터셋 생성 모델 선택(모델명=주소)
EVAL_GEN_VLLM_MODELS=gemma-4-31B-it-FP8=http://10.10.10.110:8112
