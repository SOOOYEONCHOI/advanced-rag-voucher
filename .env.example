# .env 견본 (2026.10.20 추가)
#   cp .env.example .env 후 값을 채운다. .env는 저장소에 올리지 않는다.
#   실제 주소·비밀번호·키는 이 파일에 쓰지 않는다(이름만 관리). 값은 담당자에게 받는다.
#   [필수] 비우면 백엔드가 기동하지 않는다. 주석(#) 처리된 항목은 선택 — 빼 두면 코드 기본값을 쓴다
#   (빈 값으로 두면 숫자·참거짓 항목은 설정 오류가 나므로 쓰지 않을 항목은 주석으로 둔다).

# ── 관리자 (D-19: dev 컨테이너는 활성 관리자가 없을 때 이 값으로 자동 생성, 운영은 scripts/create_admin.py) ──
ADMIN_PASSWORD=
# 2026.11.11(sooyeon.choi) 추가 - dev 관리자 자동 생성 on/off(운영은 쓰지 않음)
# DEV_BOOTSTRAP_ADMIN=true
# DEV_BOOTSTRAP_ADMIN_ID=admin

# ── PostgreSQL (DB 이름 규칙: rag_chatbot_dev / rag_chatbot_test / rag_chatbot_prod) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot_dev
POSTGRES_TEST_DB=rag_chatbot_test
POSTGRES_USER=rag_chatbot
POSTGRES_PASSWORD=

# ── Qdrant ──
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── LLM (vLLM, GPU 서버 자체 서빙) [필수] ──
VLLM_API_URL=
VLLM_API_KEY=
VLLM_MODEL_NAME=
VLLM_MAX_MODEL_LEN=
VLLM_MAX_TOKENS=
VLLM_TEMPERATURE=
VLLM_TP_SIZE=
# VLLM_GPU_MEMORY_UTILIZATION=
# MAX_PROMPT_TOKENS=
# MAX_CONTEXT_CHARS=
# OLLAMA_API_URL=
# OLLAMA_MODEL_NAME=
# VLLM_TIMEOUT=

# ── 임베딩 [필수] ──
EMBEDDING_API_URL=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIM=
EMBEDDING_MAX_MODEL_LEN=
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT=
# EMBEDDING_BATCH_SIZE=

# ── 리랭커 [필수] ──
ENABLE_RERANKING=
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
# 2026.11.19(sooyeon.choi) 수정 - 리랭커 입력 형식(plain 기본 / qwen3 = Qwen3-Reranker 공식 지시문 형식), 지시문
RERANKER_PROMPT_FORMAT=plain
# RERANKER_INSTRUCTION=

# ── VLM (이미지 설명) ──
# VLM_API_URL=
# VLM_API_KEY=
# VLM_MODEL_NAME=

# ── 음성 (STT·TTS) ──
# VOICE_ASR_API_URL=
# VOICE_ASR_MODEL_NAME=
# VOICE_ASR_TIMEOUT=
# VOICE_MAX_UPLOAD_BYTES=
# VOICE_TTS_API_URL=
# VOICE_TTS_MODEL_NAME=
# VOICE_TTS_TIMEOUT=
# VOICE_TTS_VOICE=
# 음성 e2e 테스트용(-m voice)
# VOICE_ASR_E2E_AUDIO_PATH=
# VOICE_ASR_E2E_MAX_CER=
# VOICE_TTS_E2E_TEXT_PATH=
# VOICE_TTS_E2E_MAX_CER=

# ── 문서 파서 (docling-parser) [필수] ──
DOCLING_PARSER_HOST=
# DOCLING_API_KEY=
# dev compose 기본값 backend(excel_ingest)
# EXCEL_PARSE_MODE=backend
# 엑셀 사진 전부 자동 연결(기본 true, false면 SOP Step 사진만 연결)
# EXCEL_IMAGE_LINK_ALL=true
# 2026.11.12(sooyeon.choi) 도면 파싱 기능 추가 - off(기본)면 .dwg·.dxf 업로드 불가. backend면 변환·추출·이미지 저장(검색 미적용)
# DRAWING_PARSE_MODE=off
# LIBREDWG_BIN=dwg2dxf
# DWG_CONVERT_TIMEOUT_SEC=120
# DRAWING_MAX_UPLOAD_MB=100
# DRAWING_RENDER_MAX_PX=4000
# 2026.11.06(sooyeon.choi) 추가 - 답변 하단 사진 기준. llm(기본·기존)=LLM 인용 사진, citation=인용 출처의 연결 사진
# ANSWER_IMAGE_SOURCE=llm
# RAG_MAX_IMAGES=4
# 2026.11.06(sooyeon.choi) 수정 - 이전 버전 복원(UI-12). 복원을 켜려면 보존도 켜야 한다(기본 둘 다 false)
# DOCUMENT_VERSION_VECTOR_RETENTION_ENABLED=false
# DOCUMENT_VERSION_RESTORE_ENABLED=false
# 2026.11.06(sooyeon.choi) 추가 - 비활성 버전 제외 조건: nested(기본) | doc_version(백필 후 사용)
# DOCUMENT_VERSION_FILTER_MODE=nested

# ── 검색·청킹 [필수] ──
SPARSE_ENCODER_TYPE=
MAX_CHUNK_SIZE=
CHUNK_OVERLAP=
TOP_K_RESULTS=
ENABLE_SEMANTIC_ENRICHMENT=
ENABLE_METADATA_FILTERING=
ENABLE_QUERY_PREPROCESSING=
# 2026.11.10(sooyeon.choi) 추가 - 질의 "N조/N항/N호" → "제N조" 법령 표기 변환·법령 질의 분류(기본 true)
#   2026.11.11 결정: 법령 문서도 사용하므로 true 유지. 법령 문서가 없는 SOP 전용 환경에서만 false
# QUERY_LAW_NOTATION_NORMALIZE=true
# 2026.11.10(sooyeon.choi) 추가 - BM25 토큰 정책. kiwi-bm25-v1(기본, 기존) / kiwi-bm25-v2(모델 코드·규격·호기 보존)
#   바꾼 뒤 adrag_backend/scripts/rebuild_kiwi_bm25.py --apply 로 기존 포인트 BM25를 다시 계산해야 한다
# KIWI_BM25_ENCODER_VERSION=kiwi-bm25-v2
# 2026.11.11(sooyeon.choi) 추가 - 질의 유형별 RRF 가중치 표. legacy(기본, 기존) / sop(법령 조문 질의 외 Dense 1.0·BM25 1.5)
# QUERY_TYPE_PROFILE=sop
# 2026.11.11(sooyeon.choi) 추가 - Dense 가중치 중 원문 질의 비중(0~1). 비우면 원문·재작성 질의 균등(기존). 권장 0.5
# DENSE_ORIGINAL_QUERY_SHARE=0.5
# HYBRID_RRF_K=60   # 실험 권장 20. 법령 컬렉션에도 영향 → 법령 골든셋 확인 후 변경
# BM42_MODEL_NAME=
# SPLADE_API_URL=
# SPLADE_MODEL_NAME=
# HYBRID_RRF_K=
# MAX_QUERY_TOP_K=
# MAX_CITATION_RESULTS=
# ANONYMOUS_DEFAULT_COLLECTIONS=
# MD_SAVE_DIR=
# UPLOADED_FILES_BASE_DIR=
# CHUNK_OUTPUT_DIR=
# INGEST_QUEUE_DIR=

# ── 모델 캐시 [필수] (dev 컨테이너는 compose가 /root/.cache/huggingface로 고정) ──
HF_CACHE_DIR=
# HF_TOKEN=

# ── 인증·웹 [필수] ──
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=
CORS_ORIGINS=

# ── spreadsheet resource 저장 (docker-compose가 그대로 전달) ──
RESOURCE_STORAGE_ROOT=
RESOURCE_INTERNAL_API_KEY=
RESOURCE_MAX_UPLOAD_BYTES=
RESOURCE_STAGING_TTL_HOURS=
# RESOURCE_CLEANUP_INTERVAL_SECONDS=
RESOURCE_DELIVERY=pull
BACKEND_CALLBACK_URL=

# ── 평가(offline_evaluation) ──
# 2026.11.17(sooyeon.choi) 삭제 - ANSWER_CORRECTNESS_JUDGE_BACKEND / _MODEL (RAGAS Judge 지표 삭제)
# 2026.11.17(sooyeon.choi) 추가 - 평가 전용 인용 누락 보정(LLM 재호출), 기본 false
# EVAL_CITATION_REPAIR_ENABLED=
# 2026.11.18(sooyeon.choi) 추가 - 시험 대응 일괄 질의(API 업로드 → 순차 실행 → CSV/xlsx). 기본 false(끄면 API 404)
# EVAL_BATCH_QUERY_ENABLED=
# EVAL_BATCH_MAX_ROWS=
# EVAL_BATCH_WARMUP_COUNT=
# EVAL_BATCH_QUERY_TIMEOUT_S=
# EVAL_BATCH_TOP_N_RECORD=
# EVAL_BATCH_UPLOAD_MAX_MB=
# 2026.11.18(sooyeon.choi) 추가 - 데이터셋 생성에 쓸 추가 vLLM 모델. "모델명=주소" 쉼표 구분(모델명은 --served-model-name)
#   비우면 챗봇 기본 LLM만 선택 가능. 예: EVAL_GEN_VLLM_MODELS=gemma-4-31B-it-FP8=http://<GPU서버>:8112
# EVAL_GEN_VLLM_MODELS=
# 스크립트(scripts/eval_batch_query.py) 로그인 계정 — 서버 .env가 아니라 실행하는 셸에만 설정
# EVAL_ADMIN_ID=
# EVAL_ADMIN_PASSWORD=
# OPENAI_API_KEY=   # 외부 AI API 호출 금지(CLAUDE.md 절대 규칙 7) — 채우지 않는다

# ── 로그 ──
LOG_LEVEL=
LOG_RETENTION_DAYS=
LOG_ERROR_RETENTION_DAYS=
